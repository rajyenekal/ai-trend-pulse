# AI Trend Pulse - Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Optional: Google Gemini API Key for AI Trend synthesis & briefing generation
# If not provided, the pipeline gracefully falls back to deterministic heuristic extraction.
GEMINI_API_KEY=

# Optional: GitHub API personal access token for higher rate limits (5,000 req/hr vs 60 req/hr)
# If not provided, the GitHub developer trends collector uses the public unauthenticated endpoint.
GH_TOKEN=

# Optional: MCP data source path (defaults to ./data.json)
AI_TREND_PULSE_DATA_PATH=./data.json

# Optional: Public data URL if MCP reads the deployed dataset
AI_TREND_PULSE_DATA_URL=https://rajyenekal.github.io/ai-trend-pulse/data.json

